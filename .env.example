# ==============================================================================
# AFI-L'UE — Configuration des variables d'environnement
# ==============================================================================
# IMPORTANT:
# 1. Ne JAMAIS committer de fichier .env contenant des valeurs réelles en production.
# 2. Les variables préfixées par NEXT_PUBLIC_ sont exposées au navigateur (client).
# 3. La clé SUPABASE_SERVICE_ROLE_KEY NE DOIT JAMAIS avoir le préfixe NEXT_PUBLIC_.
# ==============================================================================

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Autohébergé (VPS Contabo via Coolify)
# ------------------------------------------------------------------------------
# URL publique du service Supabase (Kong Gateway ou domaine direct)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.afi-ue.sn

# Clé anonyme publique (Anon Key) pour les requêtes client RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemple_anon_key_pour_modele

# Clé Secrète de service (Service Role Key) — UNIQUEMENT SERVEUR (Admin backend / Cron)
# ATTENTION: Cette clé outrepasse les règles RLS. NE PAS L'EXPOSER CÔTÉ CLIENT.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemple_service_role_key_confidentielle

# ------------------------------------------------------------------------------
# PostgreSQL Connexion Directe (Optionnel pour scripts de migration & seed)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:votre_mot_de_passe_robuste@vps_ip_ou_hote:5432/postgres

# ------------------------------------------------------------------------------
# Stockage Supabase (Buckets S3 / Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_DOCS=candidatures-documents
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_MEDIA=media-public

# ------------------------------------------------------------------------------
# Notifications & Emails (SMTP / Resend pour confirmations de candidature)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@afi-ue.sn
SMTP_PASS=votre_mot_de_passe_smtp
EMAIL_FROM="Université AFI-L'UE <admission@afi-ue.sn>"
NOTIFICATION_RECIPIENT="scolarite@afi-ue.sn"

# ------------------------------------------------------------------------------
# Paramètres d'environnement
# ------------------------------------------------------------------------------
NODE_ENV=development
